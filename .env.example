# Copiez ce fichier en .env. Ne publiez jamais .env.
NODE_ENV=development
API_PORT=4000
# Adresse du site (frontend) autorisée par CORS
WEB_ORIGIN=http://localhost:5173

# Base PostgreSQL (Neon en production). Mot de passe uniquement ici, jamais dans le code.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# pg = TCP 5432 (par défaut) ; neon = WebSocket sur 443 (réseaux qui bloquent 5432)
DB_DRIVER=pg
# Chaîne aléatoire d'au moins 32 caractères : openssl rand -hex 32
JWT_SECRET=
# Mot de passe des comptes de démonstration (npm run seed -- --demo)
SEED_DEMO_PASSWORD=

# ---------- SM-IA (API Anthropic) ----------
# Clé serveur uniquement. Vide : « npm run demo » utilise le simulateur local.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://127.0.0.1:4100

# ---------- SMS ----------
# console (développement), http (passerelle du prestataire retenu) ou orange (API SMS Orange)
SMS_PROVIDER=console
OTP_REQUIRED=true
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=

# ---------- Paiements des services ----------
# Sans clés : référence déclarée, confirmée par l'équipe finance.
WAVE_API_KEY=
WAVE_SIGNING_SECRET=
WAVE_WEBHOOK_SECRET=
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_WEBPAY_URL=
OM_STATUS_URL=
API_PUBLIC_URL=
