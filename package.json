{
  "name": "sunu-market-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 test/*.test.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "mock-ai": "node scripts/mock-anthropic.js 4100",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  },
  "description": "API de Sunu-Market (Express, PostgreSQL, SM-IA)",
  "engines": {
    "node": ">=22"
  }
}